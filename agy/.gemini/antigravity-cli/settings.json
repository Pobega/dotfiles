{
  "enableTerminalSandbox": true,
  "model": "Gemini 4 Argon (Medium)",
  "permissions": {
    "deny": [
      "command(ssh *)",
      "command(scp *)",
      "command(sftp *)",
      "command(cat ~/.ssh/*)",
      "command(cat ~/.aws/*)",
      "command(cat ~/.config/gh/*)",
      "command(cat ~/.gnupg/*)",
      "command(cat ~/.kube/*)",
      "command(cat ~/.docker/*)",
      "command(cat ~/.netrc)",
      "command(cat ~/.npmrc)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/statusline.sh",
    "enabled": true,
    "stack_with_default": true
  },
  "toolPermission": "proceed-in-sandbox"
}
